# Godot 4+ specific ignores
.godot/
/android/

# Exported builds, but keep the generated asset worklist (CI diffs it).
/exports/*
!/exports/asset_worklist.md

.DS_Store
**/.DS_Store

.vscode/*
!.vscode/extensions.json

# Personal, non-shared Claude Code config.
/CLAUDE.local.md
/.claude/settings.local.json

# Brisklance self-update scratch dirs (only present mid-update / after an
# interrupted update).
/addons/brisklance/.brisklance_manager_update/
/addons/brisklance/.brisklance_manager_backup/